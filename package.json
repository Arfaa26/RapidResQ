{
  "name": "rapidresq-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --import ./backend/node_modules/tsx/dist/loader.mjs --test frontend/tests/*.test.ts backend/tests/*.test.ts",
    "install:apps": "npm install --prefix backend && npm install --prefix frontend",
    "postinstall": "npm run install:apps",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"API,WEB\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build": "npm run build:frontend && npm run build:backend",
    "lint": "npm --prefix frontend run lint",
    "check": "npm run lint && npm run build",
    "start": "npm --prefix backend start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
